@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:'Playfair Display', Georgia, 'Times New Roman', Times, serif;background:#080810;color:#f1f5f9;min-height:100vh;line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
:root{--accent:#db2777;--bg:#080810;--bg-alt:#0f0f1c;--surface:#13131f;--border:#1e1e30;--text:#f1f5f9;--text-muted:#8892a4;--nav-h:58px}
::selection{background:rgba(219,39,119,0.28);color:#f1f5f9}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.75)}}
@keyframes shimmer-btn{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

/* ── Mesh background ── */
.bg-mesh{position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(ellipse 100% 55% at 50% -10%,#db277720 0%,transparent 60%),
             radial-gradient(ellipse 60% 50% at 90% 15%,#db277712 0%,transparent 55%),
             radial-gradient(ellipse 50% 40% at 5% 75%,#6366f10d 0%,transparent 55%)}

/* ── Nav ── */
.cnav{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;
  padding:0 2rem;height:var(--nav-h);background:rgba(8,8,16,0.92);backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid #1e1e30;
  transition:box-shadow .3s,background .3s}
.cnav.scrolled{box-shadow:0 2px 24px rgba(0,0,0,.28);border-bottom-color:#1e1e30}
.cnav-brand{font-weight:900;font-size:1rem;color:#f1f5f9;text-decoration:none;letter-spacing:-.02em;display:flex;align-items:center;gap:.1rem}
.cnav-brand-dot{color:var(--accent);font-size:1.3rem;line-height:1;margin-left:.05rem;animation:pulse 3s ease-in-out infinite}
.cnav-links{display:flex;gap:.15rem;align-items:center}
.cnav-link{font-size:.82rem;font-weight:500;color:#8892a4;text-decoration:none;
  padding:.35rem .8rem;border-radius:9999px;transition:color .2s,background .2s}
.cnav-link:hover{color:#f1f5f9;background:#13131f}
.cnav-cta{font-size:.8rem;font-weight:700;color:#fff;background:var(--accent);text-decoration:none;
  padding:.42rem 1.1rem;border-radius:9999px;transition:opacity .2s,transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .2s;
  box-shadow:0 2px 12px rgba(219,39,119,0.35)}
.cnav-cta:hover{opacity:.92;transform:translateY(-2px) scale(1.03);box-shadow:0 6px 20px rgba(219,39,119,0.5)}
@media(max-width:640px){.cnav-links{display:none}.cnav{padding:0 1.25rem}}

/* ── Page wrapper ── */
.cpage{position:relative;z-index:1}

/* ── Scroll offset for sticky nav ── */
[id]{scroll-margin-top:calc(var(--nav-h) + 16px)}

/* ── Banner ── */
.site-banner{position:relative;width:100%;height:128px;overflow:hidden;flex-shrink:0}
.site-banner img{width:100%;height:100%;object-fit:cover;display:block}
.banner-grad{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.12) 0%,#080810 100%)}

/* ── Scroll reveal ── */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .65s cubic-bezier(.16,1,.3,1),transform .65s cubic-bezier(.16,1,.3,1);transition-delay:var(--delay,0s)}
.reveal.visible{opacity:1;transform:none}

/* ── Buttons ── */
.btn-p{display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.65rem;border-radius:9999px;font-size:.88rem;font-weight:700;
  text-decoration:none;background:var(--accent);color:#fff;position:relative;overflow:hidden;
  box-shadow:0 4px 18px rgba(219,39,119,0.38);transition:opacity .2s,transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s}
.btn-p::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.22) 50%,transparent 65%);
  transform:translateX(-100%);transition:transform .5s ease}
.btn-p:hover::after{transform:translateX(100%)}
.btn-p:hover{opacity:.93;transform:translateY(-2px) scale(1.02);box-shadow:0 10px 32px rgba(219,39,119,0.52)}
.btn-g{display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.65rem;border-radius:9999px;font-size:.88rem;font-weight:700;
  text-decoration:none;background:#13131f;color:#f1f5f9;border:1.5px solid #1e1e30;
  transition:border-color .2s,color .2s,background .2s,transform .25s cubic-bezier(.34,1.56,.64,1)}
.btn-g:hover{border-color:var(--accent);color:var(--accent);background:rgba(219,39,119,0.06);transform:translateY(-2px) scale(1.02)}

/* ── Section heading ── */
.sec-label{display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem}
.sec-label-text{font-size:.65rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.sec-label-line{flex:1;height:1px;background:#1e1e30}

/* ── Skill tags ── */
.skill-tag{display:inline-block;padding:.4rem 1rem;border-radius:9999px;font-size:.82rem;font-weight:600;
  color:#f1f5f9;background:#13131f;border:1px solid #1e1e30;
  transition:color .2s,border-color .2s,background .2s,transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .22s;cursor:default}
.skill-tag:hover{color:var(--accent);border-color:var(--accent);background:rgba(219,39,119,0.08);transform:translateY(-2px) scale(1.04);box-shadow:0 4px 14px rgba(219,39,119,0.18)}

/* ── Timeline ── */
.tl{display:flex;flex-direction:column}
.tl-item{display:flex;gap:1.25rem;padding-bottom:2rem}
.tl-item:last-child{padding-bottom:0}
.tl-dot-col{display:flex;flex-direction:column;align-items:center;padding-top:.35rem;width:16px;flex-shrink:0}
.tl-dot{width:13px;height:13px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px rgba(219,39,119,0.18),0 0 10px rgba(219,39,119,0.5);border:2px solid #080810;flex-shrink:0;z-index:1}
.tl-line{width:2px;flex:1;margin-top:5px;background:linear-gradient(to bottom,rgba(219,39,119,0.5),rgba(219,39,119,0.05));min-height:24px}
.tl-body{flex:1;min-width:0}
.tl-head{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:.22rem}
.tl-role{font-size:1.02rem;font-weight:800;color:#f1f5f9;letter-spacing:-.01em;line-height:1.3}
.tl-period{font-size:.71rem;font-weight:700;color:var(--accent);background:rgba(219,39,119,0.1);border:1px solid rgba(219,39,119,0.22);padding:.15rem .6rem;border-radius:9999px;white-space:nowrap;flex-shrink:0;margin-top:.1rem}
.tl-co{font-size:.875rem;font-weight:600;color:#8892a4;margin-bottom:.45rem}
.tl-desc{font-size:.84rem;color:#8892a4;line-height:1.72}

/* ── Edu cards ── */
.edu-card{display:flex;gap:1rem;align-items:flex-start;background:#13131f;border:1px solid #1e1e30;
  border-radius:16px;padding:1.2rem 1.25rem;margin-bottom:.75rem;
  transition:border-color .22s,transform .28s cubic-bezier(.34,1.56,.64,1),box-shadow .22s}
.edu-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 8px 28px rgba(219,39,119,0.12)}
.edu-icon{width:40px;height:40px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
  color:var(--accent);background:rgba(219,39,119,0.12);border:1px solid rgba(219,39,119,0.25)}
.edu-school{font-size:.96rem;font-weight:800;color:#f1f5f9;letter-spacing:-.01em}
.edu-degree{font-size:.82rem;font-weight:600;color:var(--accent);margin-top:3px}
.edu-period{font-size:.75rem;color:#8892a4;margin-top:3px}

/* ── Project cards ── */
.proj-grid{display:grid;gap:1.25rem;grid-template-columns:1fr}
@media(min-width:540px){.proj-grid{grid-template-columns:1fr 1fr}}
.proj-card{background:#13131f;border:1px solid #1e1e30;border-radius:18px;overflow:hidden;
  text-decoration:none;color:inherit;display:flex;flex-direction:column;
  transition:border-color .25s,transform .32s cubic-bezier(.34,1.4,.64,1),box-shadow .32s,background .25s}
.proj-card:hover{border-color:var(--accent);transform:translateY(-6px) scale(1.01);box-shadow:0 20px 56px rgba(219,39,119,0.18);background:#1a1a2e}
.proj-img{height:172px;overflow:hidden;flex-shrink:0}
.proj-img img{width:100%;height:100%;object-fit:cover;transition:transform .45s}
.proj-card:hover .proj-img img{transform:scale(1.07)}
.proj-body{padding:1.1rem;flex:1;display:flex;flex-direction:column;gap:.55rem}
.proj-top{display:flex;align-items:flex-start;justify-content:space-between;gap:.4rem}
.proj-title{font-size:.97rem;font-weight:800;color:#f1f5f9;line-height:1.3}
.proj-arrow{font-size:1.15rem;color:var(--accent);opacity:0;transform:translate(-4px,4px);transition:opacity .2s,transform .22s;flex-shrink:0}
.proj-card:hover .proj-arrow{opacity:1;transform:translate(0,0)}
.proj-desc{font-size:.84rem;color:#8892a4;line-height:1.65;flex:1}
.proj-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:auto;padding-top:.25rem}
.proj-tag{font-size:.71rem;font-weight:700;color:var(--accent);background:rgba(219,39,119,0.1);border:1px solid rgba(219,39,119,0.22);border-radius:5px;padding:.14rem .52rem}

/* ── Social pills ── */
.soc-pill{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;
  text-decoration:none;color:#fff;transition:transform .2s,box-shadow .2s;flex-shrink:0}
.soc-pill:hover{transform:translateY(-3px);box-shadow:0 6px 18px rgba(0,0,0,.3)}

/* ── Contact box ── */
.contact-box{background:#13131f;border:1px solid #1e1e30;border-radius:22px;padding:2.75rem 2.25rem;text-align:center;max-width:580px;margin:0 auto;transition:border-color .3s,box-shadow .3s}
.contact-box:hover{border-color:rgba(219,39,119,0.38);box-shadow:0 8px 40px rgba(219,39,119,0.08)}
.contact-h{font-size:clamp(1.4rem,3.5vw,2rem);font-weight:900;letter-spacing:-.025em;color:#f1f5f9;margin-bottom:.65rem}
.contact-sub{font-size:.93rem;color:#8892a4;max-width:400px;margin:0 auto 1.85rem;line-height:1.75}
.contact-socials{display:flex;gap:.65rem;justify-content:center;flex-wrap:wrap;margin-top:1.1rem}
.contact-soc{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;
  background:#13131f;border:1px solid #1e1e30;color:#8892a4;text-decoration:none;
  transition:color .2s,border-color .2s,background .2s,transform .22s cubic-bezier(.34,1.56,.64,1)}
.contact-soc:hover{color:var(--accent);border-color:var(--accent);background:rgba(219,39,119,0.08);transform:translateY(-3px)}

/* ── Footer ── */
.site-footer{padding:2.25rem 1.5rem;border-top:1px solid #1e1e30}
.site-footer-inner{max-width:780px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:.75rem;text-align:center}
.site-footer-name{font-size:.95rem;font-weight:800;color:#f1f5f9;letter-spacing:-.01em}
.site-footer-meta{font-size:.78rem;color:#3d4460}
.site-footer-meta a{color:var(--accent);text-decoration:none}
.site-footer-socials{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;margin-top:.25rem}

/* ── Project card — no-image placeholder ── */
.proj-img-placeholder{height:100px;flex-shrink:0;background:linear-gradient(135deg,rgba(219,39,119,0.18) 0%,rgba(219,39,119,0.06) 100%);display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.proj-img-placeholder::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(135deg,rgba(219,39,119,0.04) 0,rgba(219,39,119,0.04) 1px,transparent 0,transparent 50%);background-size:18px 18px}
.proj-img-placeholder svg{opacity:.22;flex-shrink:0}

/* ── Responsive ── */
@media(max-width:520px){
  .cpage-inner{padding:0 1rem 3rem}
  .hero-mobile-stack{flex-direction:column !important;align-items:flex-start !important;gap:1.25rem !important}
  .hero-mobile-stack .hero-avatar{align-self:flex-start}
  .hero-mobile-name{font-size:clamp(1.65rem,8vw,2.2rem) !important}
}


  </style>
